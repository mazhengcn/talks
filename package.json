{
  "name": "zheng-talks",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rimraf dist && bun run --parallel --workspaces build && bun run metadata",
    "dev": "bun scripts/picker.ts dev --open",
    "metadata": "bun run scripts/collect-metadata.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "update": "bun scripts/redirects.ts"
  },
  "workspaces": {
    "packages": [
      "talks/*"
    ],
    "catalog": {
      "@slidev/cli": "52.15.1",
      "@slidev/client": "52.15.1",
      "@slidev/theme-default": "^0.25.0",
      "unocss": "^66.7.2",
      "vite": "^8.0.0"
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/prompts": "^2.4.9",
    "@types/seedrandom": "^3.0.8",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "find-up": "^8.0.0",
    "katex": "^0.17.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "playwright-chromium": "^1.61.1",
    "prompts": "^2.4.2",
    "rimraf": "^6.1.3",
    "seedrandom": "^3.0.5",
    "tinyexec": "^1.2.4"
  }
}
