{
  "name": "zheng-talks",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rimraf dist && bun run --parallel --workspaces build && bun run metadata",
    "dev": "bun scripts/picker.ts dev --open",
    "metadata": "bun run scripts/collect-metadata.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "update": "bun scripts/redirects.ts"
  },
  "workspaces": {
    "packages": [
      "talks/*"
    ],
    "catalog": {
      "@slidev/cli": "^52.12.0",
      "@slidev/client": "^52.12.0",
      "@slidev/theme-default": "^0.25.0",
      "unocss": "^66.6.6",
      "vite": "^8.0.0"
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.2",
    "@types/node": "^25.5.0",
    "@types/prompts": "^2.4.9",
    "@types/seedrandom": "^3.0.8",
    "eslint": "^10.0.3",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "find-up": "^8.0.0",
    "katex": "^0.16.38",
    "prettier-plugin-slidev": "^1.0.5",
    "prompts": "^2.4.2",
    "rimraf": "^6.1.3",
    "seedrandom": "^3.0.5",
    "tinyexec": "^1.0.2"
  }
}
