{
  "name": "Talks",
  "dockerComposeFile": "compose.yaml",
  "service": "talks",
  "workspaceFolder": "/talks",
  "customizations": {
    "vscode": {
      "extensions": [
        "oven.bun-vscode",
        "antfu.slidev",
        "antfu.unocss",
        "dbaeumer.vscode-eslint",
        "antfu.iconify",
        "Vue.volar"
      ]
    }
  },
  "postCreateCommand": {
    "fix-permissions": "sudo chown bun node_modules",
    "install-dependencies": "bun install"
  },
  "remoteUser": "bun"
}
