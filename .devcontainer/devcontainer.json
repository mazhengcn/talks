{
  "name": "Talks",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainer-community/devcontainer-features/starship.rs:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "oven.bun-vscode",
        "antfu.slidev",
        "antfu.unocss",
        "dbaeumer.vscode-eslint",
        "antfu.iconify",
        "Vue.volar"
      ]
    }
  },
  "mounts": [
    {
      "source": "${localWorkspaceFolderBasename}-node_modules",
      "target": "${containerWorkspaceFolder}/node_modules",
      "type": "volume"
    }
  ],
  "postCreateCommand": {
    "add-starship": "echo 'eval \"$(starship init bash)\"' >> ~/.bashrc",
    "fix-permissions": "sudo chown bun node_modules",
    "install-dependencies": "bun install"
  },
  "remoteUser": "bun"
}
