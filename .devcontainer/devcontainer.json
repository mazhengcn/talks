{
  "name": "Talks",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "oven.bun-vscode",
        "antfu.slidev",
        "antfu.unocss",
        "dbaeumer.vscode-eslint",
        "antfu.iconify",
        "Vue.volar"
      ]
    }
  },
  "mounts": [
    "type=volume,source=${localWorkspaceFolderBasename}-node_modules,target=${containerWorkspaceFolder}/node_modules"
  ],
  "postCreateCommand": {
    "install-dependencies": "sudo chown bun node_modules && bun install"
  },
  "remoteUser": "bun"
}
