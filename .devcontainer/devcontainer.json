{
  "name": "Talks",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "oven.bun-vscode",
        "antfu.slidev",
        "antfu.unocss",
        "dbaeumer.vscode-eslint",
        "antfu.iconify",
        "Vue.volar"
      ]
    }
  },
  "mounts": [
    {
      "type": "volume",
      "source": "${localWorkspaceFolderBasename}-node_modules",
      "target": "${containerWorkspaceFolder}/node_modules"
    }
  ],
  "postCreateCommand": {
    "fix-permissions": "sudo chown bun node_modules",
    "install-dependencies": "bun install"
  },
  "remoteUser": "bun"
}
